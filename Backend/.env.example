# Copy this file to .env for local development. On Render, set these as
# environment variables in the dashboard instead - never commit a real .env.

NODE_ENV=development
PORT=5000

# --- Database -----------------------------------------------------------
# Render: use the "Internal Database URL" from your Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/kenya_stays

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters in production.
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=7d

# --- CORS -------------------------------------------------------------
# Comma-separated list of exact origins allowed to call this API from a
# browser. Required in production. Left empty in development, everything
# is allowed for convenience.
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# --- Rate limiting (optional - sensible defaults if unset) ---------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# --- Pay Hero -------------------------------------------------------------
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=https://your-api.example.com/api/payments/payhero/callback
# Long random value - required in production. Appended to the callback URL
# handed to Pay Hero, and checked on every inbound callback, since Pay Hero
# has no signature/HMAC verification of its own.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYHERO_CALLBACK_TOKEN=
PAYHERO_REQUEST_TIMEOUT_MS=20000

# --- One-time bootstrap admin (used only by scripts/seed-admin.js) -------
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
